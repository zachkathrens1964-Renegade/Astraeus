# ---------------- Required ----------------
# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Your Discord user ID (comma-separate for several owners)
OWNER_IDS=
# Your server ID (comma-separate for several servers)
GUILD_IDS=

# ---------------- Optional (defaults shown) ----------------
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# On a safety decline, retry on Anthropic's recommended fallback model
ENABLE_FALLBACKS=true
# true = run changes WITHOUT asking you first (not recommended)
AUTO_APPROVE=false
# true = Claude may give roles the Administrator permission
ALLOW_ADMINISTRATOR_GRANT=false
CONFIRM_TIMEOUT_SECONDS=300
# How long Claude remembers the conversation, in seconds
SESSION_TTL_SECONDS=1800
MAX_ITERATIONS=25
MAX_HISTORY_MESSAGES=60
